---
import Layout from '../../layouts/Layout.astro';
import { productsData } from '../../data/products.js';

export function getStaticPaths() {
  return productsData.map((cat) => ({
    params: { category: cat.id },
    props: { activeCategory: cat, allCategories: productsData },
  }));
}

const { activeCategory, allCategories } = Astro.props;
---

<Layout title={`${activeCategory.category} - A.I.T Engineers`} description={`Explore our range of ${activeCategory.category}`}>
  <section class="products-hero band band--dark" style="padding-top: calc(var(--hdr-h) + 60px); padding-bottom: 60px;">
    <div class="shell">
      <h1 class="h1" style="margin-bottom: 1rem; text-align: center;">{activeCategory.category}</h1>
      <p class="lede" style="max-width: 800px; margin: 0 auto; color: var(--c-text-mut); text-align: center;">
        {activeCategory.description 
          ? activeCategory.description 
          : `Discover our comprehensive range of high-quality ${activeCategory.category.toLowerCase()}, designed for durability and optimal performance.`}
      </p>
    </div>
  </section>

  <section class="band band--white products-main" id="products-content" style="padding: 60px 0;">
    <div class="shell">
      <div class="products-layout">
        <!-- Sidebar Categories -->
        <aside class="products-sidebar">
          <h2 class="h4" style="margin-bottom: 1.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--c-pri, var(--blue, #006A9A));">Categories</h2>
          <ul class="category-list" id="category-list">
            {allCategories.map((cat) => (
              <li>
                <a href={`/products/${cat.id}`} class={`category-link ${cat.id === activeCategory.id ? 'active' : ''}`}>
                  {cat.category}
                  <svg viewBox="0 0 24 24" class="icon-arrow" aria-hidden="true" style="width: 16px; height: 16px;"><path fill="none" stroke="currentColor" stroke-width="2" d="m9 18 6-6-6-6"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </aside>

        <!-- Main Content Area -->
        <div class="products-content">
          <div class="product-panel">
            <div class="panel-header" style="margin-bottom: 2rem;">
              <h3 class="h3">{activeCategory.category}</h3>
              <div style="height: 3px; width: 60px; background-color: var(--c-pri, var(--blue, #006A9A)); margin-top: 10px;"></div>
            </div>
            
            {activeCategory.items && activeCategory.items.length > 0 ? (
              <div class="product-grid">
                {activeCategory.items.map((item) => (
                  <div class="product-card">
                    {item.images && item.images[0] ? (
                      <div class="card-media">
                        <img src={item.images[0]} alt={item.name} loading="lazy" class="card-img" />
                      </div>
                    ) : (
                      <div class="card-img-placeholder">
                        <svg viewBox="0 0 40 40" style="width: 40px; height: 40px; color: var(--c-pri, var(--blue, #006A9A));"><use href="#ico-mech"/></svg>
                      </div>
                    )}
                    <div class="card-body">
                      <h4 class="card-title">{item.name}</h4>
                      <div style="display: flex; gap: 10px; margin-top: auto; padding-top: 1rem;">
                        <a href={`/products/${activeCategory.id}/${item.id}`} class="btn btn--outline btn--sm" style="flex: 1; text-align: center;">View Details</a>
                        <a href="/contact" class="btn btn--outline btn--sm" style="flex: none; padding-inline: 15px;" aria-label="Enquire via WhatsApp">
                          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="color: #25D366;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        </a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="empty-state">
                <p>Detailed product specifications for {activeCategory.category} are currently being updated.</p>
                <a href="/contact" class="btn btn--primary" style="margin-top: 1rem;">Contact Us for Details</a>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .products-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Sidebar Styles */
  .products-sidebar {
    position: sticky;
    top: calc(var(--hdr-h) + 20px);
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    border: 1px solid rgba(0,0,0,0.05);
  }

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .category-link {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 1rem 1.2rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--c-text);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
  }

  .category-link:hover {
    background: rgba(0,0,0,0.03);
    color: var(--c-pri, var(--blue, #006A9A));
  }

  .category-link.active {
    background: var(--blue, #006A9A);
    color: #fff;
    box-shadow: 0 4px 12px rgba(0, 86, 179, 0.3);
  }

  .category-link.active .icon-arrow {
    transform: translateX(4px);
    color: #fff;
  }

  /* Content Styles */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .product-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.08);
  }

  .card-media {
    height: 200px;
    background: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow: hidden;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .card-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .product-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-img-placeholder {
    height: 200px;
    background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 1rem;
    color: var(--c-heading, #111);
  }

  .empty-state {
    background: #f9fafb;
    border: 2px dashed #e5e7eb;
    border-radius: 12px;
    padding: 4rem 2rem;
    text-align: center;
    color: #6b7280;
  }

  .btn--outline {
    background: transparent;
    border: 2px solid var(--c-pri, var(--blue, #006A9A));
    color: var(--c-pri, var(--blue, #006A9A));
  }
  .btn--outline:hover {
    background: var(--c-pri, var(--blue, #006A9A));
    color: #fff;
  }
  .btn--sm {
    padding: 0.6rem 1.2rem;
    font-size: 0.875rem;
  }

  /* Desktop View */
  @media (min-width: 1025px) {
    .products-layout {
      grid-template-columns: 280px 1fr;
      align-items: start;
      gap: 3rem;
    }
  }

  /* Tablet View */
  @media (min-width: 768px) and (max-width: 1024px) {
    .products-layout {
      grid-template-columns: 240px 1fr;
      align-items: start;
      gap: 2rem;
    }
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  /* Mobile View */
  @media (max-width: 767px) {
    .products-main {
      padding: 30px 0 !important;
    }
    .products-sidebar {
      position: static;
      padding: 1.25rem 1rem;
      margin-bottom: 1rem;
    }
    .products-sidebar h2 {
      font-size: 1.1rem;
      margin-bottom: 0.85rem !important;
    }
    .category-list {
      flex-direction: row;
      overflow-x: auto;
      gap: 0.5rem;
      padding-bottom: 6px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .category-link {
      white-space: nowrap;
      flex-shrink: 0;
      padding: 0.55rem 0.95rem;
      font-size: 0.85rem;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
    }
    .category-link .icon-arrow {
      display: none;
    }
    .product-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .card-media {
      height: 180px;
    }
    .card-body {
      padding: 1.25rem;
    }
  }
</style>
