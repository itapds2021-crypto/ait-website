---
import Layout from '../layouts/Layout.astro';
import { productsData } from '../data/products.js';
---

<Layout title="Our Products - A.I.T Engineers" description="Explore our wide range of engineering and fabrication products including Storage Tanks, Heat Exchangers, Silos, and more.">
  <section class="hero" id="top">
    <div class="hero__media">
      <img class="hero__img" data-parallax="0.14"
           src="/images/banner/product.png"
           alt="" aria-hidden="true" fetchpriority="high">
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__sheen" aria-hidden="true"></div>

    <!-- CAD line graphics -->
    <svg class="hero__cad" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="cad-lines">
        <path class="draw" d="M-40 700 L420 700 L640 300 L1100 300 L1480 300"/>
        <path class="draw" d="M1480 780 L1080 780 L900 460 L520 460"/>
        <path class="draw" d="M180 900 L180 640 L340 380 L340 -20"/>
        <path class="draw" d="M1240 -20 L1240 220 L1360 430 L1360 900"/>
      </g>
      <g class="cad-marks">
        <path d="M420 690v20M410 700h20"/><path d="M900 450v20M890 460h20"/>
        <path d="M340 370v20M330 380h20"/><path d="M1240 210v20M1230 220h20"/>
        <circle cx="640" cy="300" r="5"/><circle cx="1080" cy="780" r="5"/>
      </g>
      <g class="cad-apex"><path d="M980 640 L1120 400 L1260 640" /><path d="M1022 640 L1120 472 L1218 640" /></g>
    </svg>

    <div class="hero__inner shell" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
      <p class="eyebrow eyebrow--light hero__eyebrow">
        <span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span>
        A.I.T Engineers
      </p>

      <h1 class="hero__title">
        <span class="line">Our Products</span>
      </h1>

      <p class="hero__lede">Discover our comprehensive range of high-quality industrial products, designed for durability and optimal performance in demanding environments.</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="/contact">Request a Quote <svg class="btn__arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
      </div>
    </div>
  </section>

  <section class="band band--white products-main" id="products-content" style="padding: 60px 0;">
    <div class="shell">
      <div class="category-grid">
        {productsData.map((cat) => {
          const cardImg = cat.image || (cat.items && cat.items[0]?.images?.[0]);
          return (
            <a href={`/products/${cat.id}/`} class="category-card">
              {cardImg ? (
                <div class="card-media">
                  <img src={cardImg} alt={cat.category} loading="lazy" class="card-img" />
                </div>
              ) : (
                <div class="card-icon-wrap">
                  <div class="card-icon">
                    <svg viewBox="0 0 40 40" style="width: 48px; height: 48px; color: var(--c-pri, var(--blue, #006A9A));"><use href="#ico-mech"/></svg>
                  </div>
                </div>
              )}
              <div class="card-body">
                <h3 class="h4 card-title">{cat.category}</h3>
                <p class="card-desc">Explore our range of {cat.category.toLowerCase()} solutions.</p>
                <div class="card-footer">
                  <span class="btn-text">View Products</span>
                  <svg viewBox="0 0 24 24" class="icon-arrow" aria-hidden="true" style="width: 16px; height: 16px;"><path fill="none" stroke="currentColor" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 1024px) {
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .category-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .card-media {
      height: 190px;
      padding: 1rem;
    }
    .card-body {
      padding: 1.25rem;
    }
    .products-main {
      padding: 40px 0 !important;
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.07);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    color: var(--c-text);
  }

  .category-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 106, 154, 0.12);
    border-color: rgba(0, 106, 154, 0.28);
  }

  .card-media {
    width: 100%;
    height: 220px;
    background: #f8fafc;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    overflow: hidden;
    position: relative;
  }

  .card-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .category-card:hover .card-img {
    transform: scale(1.06);
  }

  .card-icon-wrap {
    padding: 2rem 2rem 0;
  }

  .card-icon {
    background: #f9fafb;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .category-card:hover .card-icon {
    background: rgba(0, 106, 154, 0.08);
  }

  .card-body {
    padding: 1.75rem 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    margin-bottom: 0.75rem;
    color: var(--c-heading, #111);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .card-desc {
    color: var(--c-text-mut);
    margin-bottom: 1.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--c-pri, var(--blue, #006A9A));
    font-weight: 600;
    font-size: 0.95rem;
    border-top: 1px solid #f1f5f9;
    padding-top: 1rem;
    margin-top: auto;
  }

  .card-footer .icon-arrow {
    transition: transform 0.3s ease;
  }

  .category-card:hover .card-footer .icon-arrow {
    transform: translateX(5px);
  }

  /* Reduced gradient overlay for clearer, brighter hero banner image */
  .hero .hero__img {
    opacity: 0.85;
  }

  .hero .hero__scrim {
    background: 
      linear-gradient(180deg, rgba(5, 8, 11, 0.48) 0%, rgba(5, 8, 11, 0.12) 35%, rgba(5, 8, 11, 0.35) 85%, rgba(5, 8, 11, 0.82) 100%),
      linear-gradient(96deg, rgba(6, 43, 70, 0.28) 0%, rgba(5, 8, 11, 0.06) 65%);
  }

  .hero .hero__sheen {
    opacity: 0.3;
  }

  .hero .hero__title {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
  }

  .hero .hero__lede {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
</style>
