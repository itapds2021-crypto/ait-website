/* ---------- 02 · COMPANY OVERVIEW ---------- */
.story__grid{display:grid;grid-template-columns:.95fr 1fr;gap:88px;align-items:center}
.story__figure{position:relative;margin:0}
.story__frame{aspect-ratio:4/5;position:relative;overflow:hidden}
.story__frame img{width:100%;height:113%;object-fit:cover;will-change:transform}
.story__body{max-width:58ch}
.story__body .h2{margin-bottom:26px}
.story__body .lede{margin-bottom:20px}

/* ---------- 04 · OUR APPROACH (dark .tl variant) ---------- */
.tl--dark::before{background:var(--hair-dark)}
.tl--dark::after{background:var(--cyan)}
.tl--dark .tl__node{background:var(--charcoal);border-color:var(--cyan)}
