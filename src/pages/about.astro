}
.plc::before{content:"";width:7px;height:7px;transform:rotate(45deg);border:1.5px solid var(--ink-3);flex:none}
.band--dark .plc,.band--charcoal .plc,.band--black .plc{color:rgba(199,209,216,.42)}
.band--dark .plc::before,.band--charcoal .plc::before,.band--black .plc::before{border-color:rgba(199,209,216,.42)}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width:1200px){
  .story__grid{gap:56px}
