/* ---------- 11 · INDUSTRIES (extends .ind) ---------- */
.ind--about{
  aspect-ratio:4/3;display:flex;flex-direction:column;justify-content:flex-end;
  padding:28px;
}
.ind--about .ind__n{position:static;margin-bottom:auto}
.ind--about .ind__t{position:static;display:block;margin-bottom:10px}
.ind--about:hover .ind__t{transform:translateY(-4px)}
.ind__d{
  position:static;z-index:2;margin:0;max-width:34ch;
  font-size:.88rem;line-height:1.5;color:rgba(199,209,216,.68);
  transition:color .5s var(--ease);
}
.ind--about:hover .ind__d{color:rgba(199,209,216,.88)}
.ind--about .ind__line{position:static;margin-top:18px}
.ind--about:hover .ind__line{width:100%}

/* ---------- 12 · WHY AIT (split) ---------- */
.whyx{display:grid;grid-template-columns:.85fr 1.15fr;gap:88px;align-items:start}
.whyx__intro{position:sticky;top:calc(var(--hdr-h) + 32px)}
.whyx__intro .h2{margin-bottom:22px}
.whyx__list{border-top:1px solid var(--hair);padding:0;list-style:none;margin:0;}
.whyx__row{
  position:relative;display:grid;grid-template-columns:64px 1fr;gap:24px;align-items:baseline;
  padding:30px 0 28px;border-bottom:1px solid var(--hair);
  transition:padding-left .55s var(--ease);
}
.whyx__row:hover{padding-left:14px}
