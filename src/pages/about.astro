.whyx__t{font-size:clamp(1.2rem,1.9vw,1.6rem);letter-spacing:-.025em;margin-bottom:8px;transition:color .5s var(--ease)}
.whyx__row:hover .whyx__t{color:var(--blue)}
.whyx__d{font-size:.94rem;color:var(--ink-2);margin:0;max-width:46ch}

/* ---------- SHARED: placeholder disclosure ---------- */
.plc{
  display:inline-flex;align-items:center;gap:10px;margin-top:28px;
