<style is:global>
/* ============================================================
   A.I.T ENGINEERS — ABOUT PAGE
   ============================================================ */

/* ---------- 01 · PAGE HERO (compact size & reduced gradient) ---------- */
.hero {
  min-height: 52vh !important;
  justify-content: center !important;
  padding-block: calc(var(--hdr-h) + 32px) 36px !important;
}

.hero .hero__title {
  font-size: clamp(2rem, 3.8vw, 3.4rem);
