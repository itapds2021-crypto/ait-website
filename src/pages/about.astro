}
.mfg__tags li:hover{background:var(--navy);color:var(--cyan)}

/* ---------- 10 · QUALITY PHILOSOPHY ---------- */
.qphil{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--hair);border:1px solid var(--hair)}
.qstep{position:relative;background:var(--white);padding:34px 28px 38px;transition:background .5s var(--ease)}
.qstep:hover{background:#fff}
