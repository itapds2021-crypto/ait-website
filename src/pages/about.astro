  opacity: 0.3;
}

/* breadcrumb */
.crumb{position:relative;margin-top:24px}
.crumb ol{display:flex;align-items:center;gap:12px;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;font-weight:600;padding:0;list-style:none;}
.crumb a{color:rgba(199,209,216,.6);transition:color .4s var(--ease);text-decoration:none;}
.crumb a:hover{color:var(--cyan)}
.crumb li[aria-current]{color:rgba(199,209,216,.95)}
