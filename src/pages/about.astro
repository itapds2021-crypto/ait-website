.tl--dark .tl__n{color:var(--cyan)}
.tl--dark .tl__t{color:#fff}
.tl__d{display:block;margin-top:10px;font-size:.88rem;line-height:1.55;color:var(--ink-2);max-width:22ch}
.tl--dark .tl__d{color:rgba(199,209,216,.62)}

/* ---------- 05 · MISSION & VISION ---------- */
.mv{position:relative;display:grid;grid-template-columns:1.15fr 1px .85fr;gap:0;align-items:start}
.mv__rule{position:relative;align-self:stretch;background:var(--hair);overflow:hidden}
.mv__rule span{position:absolute;left:0;top:0;width:100%;height:0;background:var(--blue)}
.mv__col{padding:8px 0}
.mv__col--a{padding-right:80px}
.mv__col--b{padding-left:80px;padding-top:92px}
.mv__k{
  display:block;font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;
  font-weight:600;color:var(--blue);margin-bottom:20px;
}
.mv__h{font-size:clamp(1.8rem,3.2vw,2.9rem);letter-spacing:-.03em;margin-bottom:22px}
.mv__p{font-size:clamp(1rem,1.2vw,1.14rem);line-height:1.65;color:var(--ink-2);max-width:42ch}
.mv__mark{margin-top:38px;width:96px;height:64px;color:rgba(0,106,154,.38)}
.mv__mark svg{width:100%;height:100%}

/* ---------- 06 · CORE VALUES (architectural grid) ---------- */
.vals{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--hair);border-left:1px solid var(--hair)}
.val{
  position:relative;padding:40px 32px 44px;
  border-right:1px solid var(--hair);border-bottom:1px solid var(--hair);
  transition:background .5s var(--ease);
}
.val:hover{background:#fff}
.val__n{font-size:.72rem;font-weight:600;letter-spacing:.2em;color:var(--ink-3)}
.val__line{display:block;width:100%;height:20px;margin:22px 0 20px;color:var(--blue);opacity:.55;transition:opacity .5s var(--ease)}
.val:hover .val__line{opacity:1}
.val__line svg{width:100%;height:100%}
.val h3{font-size:1.12rem;margin-bottom:10px;transition:transform .5s var(--ease)}
.val:hover h3{transform:translateX(6px)}
.val p{font-size:.9rem;color:var(--ink-2);margin:0}
.val__rule{position:absolute;left:0;top:-1px;height:2px;width:0;background:var(--blue);transition:width .6s var(--ease)}
.val:hover .val__rule{width:100%}

/* ---------- 07 · JOURNEY TIMELINE ---------- */
.jrny{position:relative;padding-top:104px}
.jrny__track,.jrny__fill{position:absolute;left:0;top:38px;height:1px}
.jrny__track{width:100%;background:var(--hair)}
.jrny__fill{width:0;background:var(--blue)}
.jrny__row{display:grid;grid-template-columns:repeat(6,1fr);gap:0;padding:0;list-style:none;margin:0;}
.jrny__item{position:relative;padding-right:28px}
.jrny__item::before{
  content:"";position:absolute;left:0;top:-72px;width:13px;height:13px;
  transform:rotate(45deg);background:var(--white);border:1.5px solid var(--blue);
  transition:background .5s var(--ease);
}
.jrny__item:hover::before{background:var(--blue)}
.jrny__item::after{
  content:"";position:absolute;left:6px;top:-58px;width:1px;height:32px;background:var(--hair);
}
.jrny__item:nth-child(even){padding-top:44px}
.jrny__item:nth-child(even)::after{height:76px}
.jrny__y{
  display:block;font-family:var(--font-h);font-weight:800;
  font-size:clamp(1.5rem,2.4vw,2.1rem);letter-spacing:-.03em;color:var(--blue);margin-bottom:8px;
}
.jrny__t{display:block;font-family:var(--font-h);font-weight:700;font-size:1rem;line-height:1.35}

/* ---------- 08 · CAPABILITY GROUPS ---------- */
.capgrp{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--hair)}
.grp{position:relative;padding:48px 44px 52px;border-right:1px solid var(--hair)}
.grp:last-child{border-right:0}
.grp__bar{position:absolute;left:0;top:-1px;height:2px;width:0;background:var(--blue);transition:width .8s var(--ease)}
.grp.is-in .grp__bar,[data-reveal].is-in .grp__bar{width:100%}
.grp__k{display:flex;align-items:center;gap:12px;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;font-weight:600;color:var(--blue);margin-bottom:26px}
.grp__k svg{width:22px;height:22px;flex:none}
.grp__h{font-size:1.5rem;letter-spacing:-.025em;margin-bottom:14px}
.grp__p{font-size:.94rem;color:var(--ink-2);margin-bottom:28px;max-width:34ch}
.grp__list{padding:0;list-style:none;margin:0;}
.grp__list li{
  display:flex;align-items:center;gap:14px;padding:14px 0;border-top:1px solid var(--hair);
  font-family:var(--font-h);font-weight:600;font-size:.98rem;
  transition:padding-left .5s var(--ease),color .4s var(--ease);
}
.grp__list li:hover{padding-left:8px;color:var(--blue)}
.grp__list li::before{content:"";width:7px;height:7px;flex:none;transform:rotate(45deg);border:1.5px solid var(--blue)}

/* ---------- 09 · MANUFACTURING COMPOSITION ---------- */
.mfg__grid{display:grid;grid-template-columns:1.35fr 1fr;gap:64px;align-items:start}
.mfg__stack{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.mfg__lead{grid-column:1/-1;position:relative;overflow:hidden;margin:0;aspect-ratio:16/10}
.mfg__lead img{width:100%;height:108%;object-fit:cover;opacity:.78;will-change:transform}
.mfg__sm{position:relative;overflow:hidden;margin:0;aspect-ratio:4/3;background:var(--black)}
.mfg__sm img{width:100%;height:100%;object-fit:cover;opacity:.7;transition:opacity .7s var(--ease)}
.mfg__sm:hover img,.mfg__lead:hover img{opacity:.95}
.mfg figcaption{
  position:absolute;left:16px;bottom:14px;display:flex;align-items:center;gap:10px;
  font-size:.66rem;letter-spacing:.18em;text-transform:uppercase;font-weight:600;color:rgba(247,249,250,.88);
}
.mfg figcaption span{display:grid;place-items:center;width:22px;height:22px;border:1px solid rgba(0,160,198,.6);color:var(--cyan);letter-spacing:0}
.mfg__body{padding-top:8px}
.mfg__body .h2{margin-bottom:24px}
.mfg__tags{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;margin-top:36px;background:var(--hair-dark);padding:0;list-style:none;}
.mfg__tags li{
