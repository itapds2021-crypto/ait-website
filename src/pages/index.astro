---
import Layout from '../layouts/Layout.astro';
---

<Layout title="A.I.T Engineers — Industrial Engineering, Fabrication & EPC Solutions" description="A.I.T Engineers delivers engineered process equipment, industrial fabrication and end-to-end project solutions for demanding process industries.">
  <!-- ============ 01 · HERO ============ -->
  <section class="hero" id="top">
    <div class="hero__media">
      <img class="hero__img" data-parallax="0.14"
           src="/images/banner/home.png"
           alt="" aria-hidden="true" fetchpriority="high">
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__sheen" aria-hidden="true"></div>

    <!-- CAD line graphics -->
    <svg class="hero__cad" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="cad-lines">
        <path class="draw" d="M-40 700 L420 700 L640 300 L1100 300 L1480 300"/>
        <path class="draw" d="M1480 780 L1080 780 L900 460 L520 460"/>
        <path class="draw" d="M180 900 L180 640 L340 380 L340 -20"/>
        <path class="draw" d="M1240 -20 L1240 220 L1360 430 L1360 900"/>
      </g>
      <g class="cad-marks">
        <path d="M420 690v20M410 700h20"/><path d="M900 450v20M890 460h20"/>
        <path d="M340 370v20M330 380h20"/><path d="M1240 210v20M1230 220h20"/>
        <circle cx="640" cy="300" r="5"/><circle cx="1080" cy="780" r="5"/>
      </g>
      <g class="cad-apex"><path d="M980 640 L1120 400 L1260 640" /><path d="M1022 640 L1120 472 L1218 640" /></g>
    </svg>

    <div class="hero__inner shell">
      <p class="eyebrow eyebrow--light hero__eyebrow">
        <span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span>
        Engineering <i class="dot">•</i> Automation <i class="dot">•</i> Fabrication <i class="dot">•</i> EPC
      </p>

      <h1 class="hero__title">
        <span class="line">Industrial Equipment</span>
        <span class="line">Engineered Around Your</span>
        <span class="line">Process Requirements</span>
      </h1>

      <p class="hero__lede">Delivering engineered process equipment, industrial fabrication and end-to-end project solutions for demanding process industries.
      <br /> Established in 2011 | Thane, Maharashtra, India</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="/contact">Request a Quote <svg class="btn__arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
        <a class="btn btn--ghost" href="/products">Explore Our Products <svg class="btn__arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
      </div>
    </div>

    <div class="hero__foot shell">
      <a class="scroller" href="#about" aria-label="Scroll to About">
        <span class="scroller__rail"><span class="scroller__dot"></span></span>
        <span class="scroller__txt">Scroll</span>
      </a>
      <p class="hero__stamp">Precision engineering built for heavy industry</p>
    </div>
  </section>

  <!-- ============ 02 · COMPANY INTRODUCTION ============ -->
  <section class="about band band--white" id="about">
    <div class="blueprint" aria-hidden="true"></div>
    <div class="shell about__grid">

      <figure class="about__figure" data-reveal>
        <div class="chamfer chamfer--lg about__frame">
          <img data-parallax="0.09" loading="lazy"
               src="/images/home-about.png"
               alt="Welding work in progress on a fabrication floor">
        </div>
        <figcaption class="figcap"><span>FIG. 01</span> Fabrication floor — heavy plate welding</figcaption>
        <span class="tick tick--tl" aria-hidden="true"></span>
        <span class="tick tick--br" aria-hidden="true"></span>
      </figure>

      <div class="about__body">
        <p class="eyebrow" data-reveal>
          <span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span>
          About A.I.T Engineers
        </p>
        <h2 class="h2" data-reveal style="--d:.06s">Engineering Experience. Practical Manufacturing.</h2>
        <p class="lede" data-reveal style="--d:.12s">Established in 2011, AIT Engineers is an industrial equipment manufacturer and supplier based in Thane, Maharashtra.</p>
        <p data-reveal style="--d:.16s">We manufacture a diverse range of equipment including storage tanks, cement and fly ash silos, heat exchanger coils, U-shape heaters, pressure vessels, testing machines and other special-purpose industrial equipment.</p>
        <p data-reveal style="--d:.16s">Our team of engineers and technicians works closely with customer requirements to deliver equipment in application-specific dimensions and specifications. Supported by manufacturing facilities, modern tools and systematic quality checks, our focus remains on dependable products and professional project execution.</p>

        <ul class="capsule" data-reveal style="--d:.22s">
          <li><svg aria-hidden="true"><use href="#ico-mech"/></svg> Engineering Design</li>
          <li><svg aria-hidden="true"><use href="#ico-fab"/></svg> Industrial Fabrication</li>
          <li><svg aria-hidden="true"><use href="#ico-auto"/></svg> Automation</li>
          <li><svg aria-hidden="true"><use href="#ico-epc"/></svg> EPC Support</li>
        </ul>

        <a class="link-cta" href="/about" data-reveal style="--d:.28s">Discover Our Company <svg aria-hidden="true"><use href="#arrow"/></svg></a>
      </div>
    </div>
  </section>

  <!-- ============ 03 · STATISTICS ============ -->
 <section class="stats band band--dark">
    <div class="apex-watermark" aria-hidden="true">
      <svg viewBox="0 0 400 300"><path d="M20 280 200 20 380 280M70 280 200 92 330 280M118 280 200 162 282 280" fill="none" stroke="currentColor" stroke-width="1"/></svg>
    </div>
    <div class="shell">
      <div class="stats__head">
        <p class="eyebrow eyebrow--light" data-reveal>
          <span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span>
          By the numbers
        </p>
        <p class="stats__note" data-reveal style="--d:.08s">Indicative figures shown for design purposes.</p>
      </div>

      <div class="stats__grid">
        <div class="stat" data-reveal><span class="stat__n"><span class="count" data-count="15">0</span><i>+</i></span><span class="stat__l">Years of Engineering Expertise</span></div>
        <div class="stat" data-reveal style="--d:.05s"><span class="stat__n"><span class="count" data-count="250">0</span><i>+</i></span><span class="stat__l">Projects Delivered</span></div>
        <div class="stat" data-reveal style="--d:.1s"><span class="stat__n"><span class="count" data-count="120">0</span><i>+</i></span><span class="stat__l">Industrial Clients</span></div>
        <div class="stat" data-reveal style="--d:.15s"><span class="stat__n"><span class="count" data-count="30">0</span><i>+</i></span><span class="stat__l">Engineering Professionals</span></div>
        <div class="stat" data-reveal style="--d:.2s"><span class="stat__n"><span class="count" data-count="6">0</span></span><span class="stat__l">Core Industries</span></div>
        <div class="stat" data-reveal style="--d:.25s"><span class="stat__n stat__n--txt">Pan-India</span><span class="stat__l">Project Capability</span></div>
      </div>
    </div>
  </section> 

  <!-- ============ 05 · PRODUCTS ============ -->
  <section class="products band band--soft" id="products">
    <div class="shell">
      <div class="sec-head">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span> Products</p>
          <h2 class="h2" data-reveal style="--d:.06s">Engineered Equipment For Industrial Applications</h2>
        </div>
        <p class="sec-head__aside" data-reveal style="--d:.12s">Built to drawing and specification, from bulk storage systems to heat transfer equipment and structural packages.</p>
      </div>

      <div class="prod__grid">
        <a class="prod prod--a" href="/products/fly-ash-storage-silo" data-reveal>
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/cement-and-fly-ash-storage-silos-1.png" alt="Fly ash storage silos"></span>
          <span class="prod__body"><span class="prod__t">Fly Ash Storage Silos</span><span class="prod__d">Bulk storage silos with aeration, discharge and support structure.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
        <a class="prod prod--b" href="/products/cement-silo" data-reveal style="--d:.05s">
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/stainless-steel-cement-silo-1.png" alt="Cement silos"></span>
          <span class="prod__body"><span class="prod__t">Cement Silos</span><span class="prod__d">Site-erected and shop-fabricated silos for cement handling.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
        <a class="prod prod--c" href="/products/storage-tank" data-reveal>
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/liquid-oxygen-storage-tank-1.png" alt="Industrial storage tanks"></span>
          <span class="prod__body"><span class="prod__t">Storage Tanks</span><span class="prod__d">Vertical and horizontal tanks for process and utility duty.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
        <a class="prod prod--d" href="/products/storage-tank/liquid-storage-underground-tank" data-reveal style="--d:.05s">
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/liquid-storage-underground-tank-1.png" alt="Underground storage tanks"></span>
          <span class="prod__body"><span class="prod__t">Underground Storage Tanks</span><span class="prod__d">Buried tankage with coating systems and anchorage detailing.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
        <a class="prod prod--e" href="/products/heat-exchanger-coil" data-reveal>
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/copper-coil-heat-exchanger-1.png" alt="Heat exchangers"></span>
          <span class="prod__body"><span class="prod__t">Heat Exchangers</span><span class="prod__d">Shell and tube assemblies built to thermal duty.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
        <a class="prod prod--f" href="/products/heat-exchanger-coil/fin-tube-type-heat-exchanger" data-reveal style="--d:.05s">
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/fin-tube-type-heat-exchanger-1.png" alt="Industrial coils"></span>
          <span class="prod__body"><span class="prod__t">Industrial Coils</span><span class="prod__d">Heating and cooling coils in carbon and stainless steel.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
        <a class="prod prod--g" href="/products/cement-storage-silos/cement-processing-silo" data-reveal style="--d:.1s">
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/cement-processing-silo-1.png" alt="Process equipment"></span>
          <span class="prod__body"><span class="prod__t">Process Equipment</span><span class="prod__d">Vessels, hoppers and skids engineered to process data.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
        <a class="prod prod--h" href="/products/cement-storage-silos" data-reveal>
          <span class="prod__media chamfer"><img loading="lazy" src="/images/products/cement-multi-storage-silo-1.png" alt="Structural fabrication and multi-storage silos"></span>
          <span class="prod__body"><span class="prod__t">Structural Fabrication</span><span class="prod__d">Platforms, gantries, supports and access steelwork fabricated to drawing.</span><span class="prod__go">Explore Product <svg aria-hidden="true"><use href="#arrow"/></svg></span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 06 · INDUSTRIES ============ -->
  <section class="inds band band--black">
    <div class="shell">
      <div class="sec-head sec-head--light">
        <div>
          <p class="eyebrow eyebrow--light" data-reveal><span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span> Industries</p>
          <h2 class="h2" data-reveal style="--d:.06s">Built Around Industrial Applications</h2>
        </div>
        <p class="sec-head__aside" data-reveal style="--d:.12s">Rather than offering one-size-fits-all equipment, AIT Engineers develops solutions according to the operating requirement, material, capacity and application.</p>
      </div>

      <div class="inds__grid">
        <a class="ind" href="#contact" data-reveal><img loading="lazy" src="/images/Bulk Material Storage and Handling.png" alt="Oil and gas"><span class="ind__n">01</span><span class="ind__t">Bulk Material Storage & Handling</span><span class="ind__line"></span></a>
        <a class="ind" href="#contact" data-reveal style="--d:.05s"><img loading="lazy" src="/images/Chemical and Liquid Storage.png" alt="Petrochemical"><span class="ind__n">02</span><span class="ind__t">Chemical & Liquid Storage</span><span class="ind__line"></span></a>
        <a class="ind" href="#contact" data-reveal style="--d:.1s"><img loading="lazy" src="/images/Heat Transfer and Thermal Applications.png" alt="Chemical"><span class="ind__n">03</span><span class="ind__t">Heat Transfer & Thermal Applications</span><span class="ind__line"></span></a>
        <a class="ind" href="#contact" data-reveal><img loading="lazy" src="/images/Industrial Manufacturing.png" alt="Cement"><span class="ind__n">04</span><span class="ind__t">Industrial Manufacturing</span><span class="ind__line"></span></a>
        <a class="ind" href="#contact" data-reveal style="--d:.05s"><img loading="lazy" src="/images/Testing and Special-Purpose Applications.png" alt="Food processing"><span class="ind__n">05</span><span class="ind__t">Testing & Special-Purpose Applications</span><span class="ind__line"></span></a>
        <a class="ind" href="#contact" data-reveal style="--d:.1s"><img loading="lazy" src="/images/Mining.png" alt="Mining"><span class="ind__n">06</span><span class="ind__t">Mining</span><span class="ind__line"></span></a>
      </div>
    </div>
  </section>

  <!-- ============ 08 · PROCESS ============ -->
  <section class="process band band--white process--tinted" id="process">
    <div class="blueprint blueprint--strong" aria-hidden="true"></div>
    <div class="shell">
      <div class="sec-head">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span> Project sequence</p>
          <h2 class="h2" data-reveal style="--d:.06s">From Requirement To Commissioning</h2>
        </div>
        <p class="sec-head__aside" data-reveal style="--d:.12s">A single technical thread runs from the first requirement review through to handover.</p>
      </div>

      <ol class="tl" id="timeline">
        <li class="tl__step"><span class="tl__node" aria-hidden="true"></span><span class="tl__n">01</span><span class="tl__t">Requirement Understanding</span></li>
        <li class="tl__step"><span class="tl__node" aria-hidden="true"></span><span class="tl__n">02</span><span class="tl__t">Technical Review</span></li>
        <li class="tl__step"><span class="tl__node" aria-hidden="true"></span><span class="tl__n">03</span><span class="tl__t">Material Procurement</span></li>
        <li class="tl__step"><span class="tl__node" aria-hidden="true"></span><span class="tl__n">04</span><span class="tl__t">Manufacturing & Fabrication</span></li>
        <li class="tl__step"><span class="tl__node" aria-hidden="true"></span><span class="tl__n">05</span><span class="tl__t">Inspection & Quality Checks</span></li>
        <li class="tl__step"><span class="tl__node" aria-hidden="true"></span><span class="tl__n">06</span><span class="tl__t">Dispatch & Delivery</span></li>
         <li class="tl__step"><span class="tl__node" aria-hidden="true"></span><span class="tl__n">07</span><span class="tl__t"> Final Documentation & Handover</span></li>
      </ol>
    </div>
  </section>

  <!-- ============ 10 · QUALITY & SAFETY ============ -->
  <section class="qual band band--white">
    <div class="blueprint blueprint--strong" aria-hidden="true"></div>
    <div class="shell">
      <div class="sec-head">
        <div>
          <p class="eyebrow" data-reveal><span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span> Quality &amp; safety</p>
          <h2 class="h2" data-reveal style="--d:.06s">Quality Engineered Into Every Stage</h2>
        </div>
        <p class="sec-head__aside" data-reveal style="--d:.12s"> Quality checks are carried out throughout manufacturing with attention to materials, dimensions and agreed specifications.</p>
      </div>

      <div class="qual__grid">
        <div class="qcell" data-reveal><svg aria-hidden="true"><use href="#ico-material"/></svg><h3>Material Selection</h3><p>Suitable raw materials are selected according to the requirements and specifications of the equipment.</p></div>
        <div class="qcell" data-reveal style="--d:.04s"><svg aria-hidden="true"><use href="#ico-caliper"/></svg><h3>Stage-Wise Quality Checks</h3><p>Quality checks are carried out at relevant stages of production to support consistency throughout manufacturing.</p></div>
        <div class="qcell" data-reveal style="--d:.08s"><svg aria-hidden="true"><use href="#ico-fab"/></svg><h3>Dimensional Attention</h3><p>Attention is given to required dimensions and agreed specifications during the manufacturing process.</p></div>
        <div class="qcell" data-reveal style="--d:.12s"><svg aria-hidden="true"><use href="#ico-weld"/></svg><h3>Manufacturing Practices</h3><p>Appropriate machinery, tools and manufacturing practices are used according to the equipment being produced.</p></div>
        <div class="qcell" data-reveal style="--d:.02s"><svg aria-hidden="true"><use href="#ico-test"/></svg><h3>Specification Focus</h3><p>Manufacturing activities are carried out with attention to the specifications agreed for the particular equipment requirement.</p></div>
        <div class="qcell" data-reveal style="--d:.06s"><svg aria-hidden="true"><use href="#ico-doc"/></svg><h3>Continuous Improvement</h3><p>AIT Engineers continues to strengthen its manufacturing facilities and production capabilities to meet evolving industrial requirements.</p></div>
        <div class="qcell" data-reveal style="--d:.1s"><svg aria-hidden="true"><use href="#ico-shield"/></svg><h3>Application-Specific Quality Control</h3><p>Quality requirements are considered according to the intended application, operating conditions and agreed technical specifications. This helps ensure the manufactured equipment aligns with defined project requirements.</p></div>
        <div class="qcell" data-reveal style="--d:.1s"><svg aria-hidden="true"><use href="#ico-shield"/></svg><h3>Safety</h3><p>Equipment safety requirements should be defined according to the application, operating conditions, material handled and agreed project specifications.</p></div>
      </div>
    </div>
  </section>

 
  <!-- ============ 14 · FAQ ============ -->
  <section class="faq band band--white">
    <div class="blueprint" aria-hidden="true"></div>
    <div class="shell faq__grid">
      <div class="faq__aside">
        <p class="eyebrow" data-reveal><span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span> Questions</p>
        <h2 class="h2" data-reveal style="--d:.06s">Frequently Asked Questions</h2>
        <p class="faq__help" data-reveal style="--d:.12s">Something not covered here? Send your drawings or a short scope note and our technical team will respond.</p>
        <a class="link-cta" href="#contact" data-reveal style="--d:.16s">Talk to an Engineer <svg aria-hidden="true"><use href="#arrow"/></svg></a>
      </div>

      <div class="acc" data-reveal>
        <div class="acc__item">
          <h3><button class="acc__q" aria-expanded="false">What does AIT Engineers manufacture?<span class="acc__ico" aria-hidden="true"></span></button></h3>
          <div class="acc__panel"><div class="acc__inner"><p>AIT Engineers manufactures industrial equipment including storage tanks, cement and fly ash silos, heat exchanger coils, U-shape heaters, pressure vessels, testing machines, buoyancy machines and other fabricated equipment.</p></div></div>
        </div>
        <div class="acc__item">
          <h3><button class="acc__q" aria-expanded="false">Does AIT Engineers manufacture customized equipment?<span class="acc__ico" aria-hidden="true"></span></button></h3>
          <div class="acc__panel"><div class="acc__inner"><p>Yes. Equipment can be developed in application-specific dimensions and specifications based on the customer's technical requirement.</p></div></div>
        </div>
        <div class="acc__item">
          <h3><button class="acc__q" aria-expanded="false">Where is AIT Engineers located?<span class="acc__ico" aria-hidden="true"></span></button></h3>
          <div class="acc__panel"><div class="acc__inner"><p>AIT Engineers is based in Thane, Maharashtra, India.</p></div></div>
        </div>
        <div class="acc__item">
          <h3><button class="acc__q" aria-expanded="false">When was AIT Engineers established?<span class="acc__ico" aria-hidden="true"></span></button></h3>
          <div class="acc__panel"><div class="acc__inner"><p>AIT Engineers was established in 2011.</p></div></div>
        </div>
        <div class="acc__item">
          <h3><button class="acc__q" aria-expanded="false">Can I discuss a custom industrial requirement with AIT Engineers?<span class="acc__ico" aria-hidden="true"></span></button></h3>
          <div class="acc__panel"><div class="acc__inner"><p>Yes. Customers can share their application, required capacity, dimensions, material preference and other available technical details for review.</p></div></div>
        </div>
        <div class="acc__item">
          <h3><button class="acc__q" aria-expanded="false">Does AIT Engineers perform quality checks during manufacturing?<span class="acc__ico" aria-hidden="true"></span></button></h3>
          <div class="acc__panel"><div class="acc__inner"><p>The company states that quality checks are conducted at different stages of production to help maintain product quality and conformity with requirements.</p></div></div>
        </div>
        <div class="acc__item">
          <h3><button class="acc__q" aria-expanded="false">What information should I provide when requesting a quotation?<span class="acc__ico" aria-hidden="true"></span></button></h3>
          <div class="acc__panel"><div class="acc__inner"><p>Where available, share the equipment type, intended application, required capacity, material of construction, dimensions, quantity, operating conditions and any drawings or technical specifications.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 15 · FINAL CTA ============ -->
  <section class="cta band band--black" id="contact">
    <div class="cta__media" aria-hidden="true">
      <img loading="lazy" src="https://images.unsplash.com/photo-1511454493857-0a29f2c023c7?auto=format&fit=crop&w=2000&q=70" alt="">
    </div>
    <div class="cta__scrim" aria-hidden="true"></div>
    <div class="cta__grid" aria-hidden="true"></div>
    <svg class="cta__cad" viewBox="0 0 1440 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="draw" d="M-40 420 L360 420 L520 160 L960 160 L1480 160"/>
      <path class="draw" d="M1480 480 L1120 480 L980 300 L620 300"/>
      <g class="cad-marks"><path d="M360 410v20M350 420h20"/><path d="M980 290v20M970 300h20"/></g>
    </svg>

    <div class="shell cta__inner">
      <h2 class="cta__t" data-reveal>Have An Industrial Project In Mind?</h2>
      <p class="cta__d" data-reveal style="--d:.08s">Discuss your engineering, fabrication or equipment requirement with our technical team.</p>
      <div class="cta__actions" data-reveal style="--d:.14s">
        <a class="btn btn--primary btn--lg" href="/contact">Request a Quote <svg class="btn__arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
        <a class="btn btn--ghost btn--lg" href="tel:+919876543210">Talk to an Engineer <svg class="btn__arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Reduced gradient overlay for clearer, brighter hero banner image */
  .hero .hero__img {
    opacity: 0.85;
  }

  .hero .hero__scrim {
    background: 
      linear-gradient(180deg, rgba(5, 8, 11, 0.48) 0%, rgba(5, 8, 11, 0.12) 35%, rgba(5, 8, 11, 0.35) 85%, rgba(5, 8, 11, 0.82) 100%),
      linear-gradient(96deg, rgba(6, 43, 70, 0.28) 0%, rgba(5, 8, 11, 0.06) 65%);
  }

  .hero .hero__sheen {
    opacity: 0.3;
  }

  .hero .hero__title {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
  }

  .hero .hero__lede {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
</style>

