---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - A.I.T Engineers" description="Contact A.I.T Engineers">
  <section class="hero" id="contact-content" style="min-height: 60vh;">
    <div class="hero__media">
      <img class="hero__img" data-parallax="0.14"
           src="/images/banner/contact-us.png"
           alt="" aria-hidden="true" fetchpriority="high">
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__sheen" aria-hidden="true"></div>

    <!-- CAD line graphics -->
    <svg class="hero__cad" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="cad-lines">
        <path class="draw" d="M-40 700 L420 700 L640 300 L1100 300 L1480 300"/>
        <path class="draw" d="M1480 780 L1080 780 L900 460 L520 460"/>
        <path class="draw" d="M180 900 L180 640 L340 380 L340 -20"/>
        <path class="draw" d="M1240 -20 L1240 220 L1360 430 L1360 900"/>
      </g>
      <g class="cad-marks">
        <path d="M420 690v20M410 700h20"/><path d="M900 450v20M890 460h20"/>
        <path d="M340 370v20M330 380h20"/><path d="M1240 210v20M1230 220h20"/>
        <circle cx="640" cy="300" r="5"/><circle cx="1080" cy="780" r="5"/>
      </g>
      <g class="cad-apex"><path d="M980 640 L1120 400 L1260 640" /><path d="M1022 640 L1120 472 L1218 640" /></g>
    </svg>

    <div class="hero__inner shell" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
      <p class="eyebrow eyebrow--light hero__eyebrow">
        <span class="eyebrow__mark" aria-hidden="true"><svg><use href="#apex"/></svg></span>
        A.I.T Engineers
      </p>

      <h1 class="hero__title">
        <span class="line">Contact Us</span>
      </h1>
    </div>
  </section>

  <section class="band band--white" style="padding: 80px 0; background-color: #fafafa;">
    <div class="shell" style="max-width: 1200px; display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; align-items: flex-start;">
      
      <!-- Contact Details -->
      <div style="background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); height: 100%; box-sizing: border-box;">
        <h2 style="font-size: 1.6rem; color: #1a365d; border-bottom: 2px solid #2b6cb0; padding-bottom: 12px; margin-bottom: 32px; font-weight: 600;">Contact Details</h2>
        
        <div style="display: flex; align-items: flex-start; margin-bottom: 28px;">
          <svg style="width: 24px; height: 24px; margin-right: 20px; color: #4a5568; margin-top: 4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          <div>
            <p style="font-weight: 600; color: #2d3748; margin: 0 0 4px 0; font-size: 1.15rem;">Mr. Dayashankar Jaiswal</p>
            <p style="color: #718096; margin: 0; font-size: 1rem;">Proprietor</p>
          </div>
        </div>

        <div style="display: flex; align-items: center; margin-bottom: 28px;">
          <svg style="width: 24px; height: 24px; margin-right: 20px; color: #4a5568;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          <p style="color: #2d3748; margin: 0; font-size: 1.15rem;">Mobile : +918045477620</p>
        </div>

        <div style="display: flex; align-items: flex-start; margin-bottom: 40px;">
          <svg style="width: 24px; height: 24px; margin-right: 20px; color: #4a5568; margin-top: 4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
          <p style="color: #2d3748; margin: 0; line-height: 1.6; font-size: 1.1rem;">
            Building No 1, Flat No 204, 2nd Floor, Near Ambika Glass House,<br />
            Dawadi, Dombivali East, Thane-421203, Maharashtra, India
          </p>
        </div>

        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="tel:+918045477620" style="padding: 12px 24px; border: 1px solid #cbd5e0; color: #2b6cb0; border-radius: 6px; font-weight: 600; text-transform: uppercase; text-decoration: none; font-size: 0.95rem; transition: all 0.2s; letter-spacing: 0.5px;">Call Me Free</a>
          <a href="sms:+918045477620" style="padding: 12px 24px; border: 1px solid #cbd5e0; color: #2b6cb0; border-radius: 6px; font-weight: 600; text-transform: uppercase; text-decoration: none; font-size: 0.95rem; transition: all 0.2s; letter-spacing: 0.5px;">Send SMS</a>
        </div>
      </div>

      <!-- Contact Form -->
      <div style="background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); height: 100%; box-sizing: border-box;">
        <h2 style="font-size: 1.6rem; color: #000; font-weight: 700; margin-bottom: 24px;">Contact Us</h2>
        
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px;">
          <span style="padding: 8px 16px; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 0.9rem; color: #4a5568; cursor: pointer; transition: background 0.2s;">Get Quotation</span>
          <span style="padding: 8px 16px; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 0.9rem; color: #4a5568; cursor: pointer; transition: background 0.2s;">Get Price List</span>
          <span style="padding: 8px 16px; border: 1px solid #e2e8f0; border-radius: 20px; font-size: 0.9rem; color: #4a5568; cursor: pointer; transition: background 0.2s;">Discuss Requirement</span>
        </div>

        <form>
          <textarea placeholder="Tell us your requirement" style="width: 100%; height: 140px; padding: 16px; border: 1px solid #cbd5e0; border-radius: 8px; margin-bottom: 20px; font-family: inherit; font-size: 1rem; color: #2d3748; resize: vertical; box-sizing: border-box; outline: none;"></textarea>
          
          <div style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; border: 1px solid #cbd5e0; border-radius: 8px; padding: 0 16px; background: #fff; height: 50px;">
              <span style="margin-right: 8px; font-size: 1rem;">🇮🇳 +91</span>
              <svg style="width: 16px; height: 16px; color: #718096;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </div>
            <input type="tel" placeholder="Mobile number" style="flex: 1; min-width: 200px; height: 50px; padding: 0 16px; border: 1px solid #cbd5e0; border-radius: 8px; box-sizing: border-box; font-family: inherit; font-size: 1rem; color: #2d3748; outline: none;">
          </div>

          <button type="button" style="width: 100%; height: 54px; background: var(--c-pri, #006A9A); color: #fff; border: none; border-radius: 8px; font-weight: 700; font-size: 1.1rem; cursor: pointer; transition: background 0.2s;">Contact Now</button>
        </form>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Reduced gradient overlay for clearer, brighter hero banner image */
  .hero .hero__img {
    opacity: 0.85;
  }

  .hero .hero__scrim {
    background: 
      linear-gradient(180deg, rgba(5, 8, 11, 0.48) 0%, rgba(5, 8, 11, 0.12) 35%, rgba(5, 8, 11, 0.35) 85%, rgba(5, 8, 11, 0.82) 100%),
      linear-gradient(96deg, rgba(6, 43, 70, 0.28) 0%, rgba(5, 8, 11, 0.06) 65%);
  }

  .hero .hero__sheen {
    opacity: 0.3;
  }

  .hero .hero__title {
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.65);
  }

  .hero .hero__lede {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }
</style>
